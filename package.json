{
  "name": "@profpowell/border-wc",
  "version": "0.3.0",
  "description": "Light-DOM web component for high-touch border effects: neon, aurora, marquee bulbs, washi tape, and more than thirty others the platform under-serves.",
  "license": "MIT",
  "type": "module",
  "main": "dist/border-wc.js",
  "module": "dist/border-wc.js",
  "types": "border-wc.d.ts",
  "exports": {
    ".": {
      "types": "./border-wc.d.ts",
      "default": "./dist/border-wc.js"
    },
    "./attr": {
      "types": "./data-border-effect.d.ts",
      "default": "./dist/data-border-effect.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "border-wc.d.ts",
    "data-border-effect.d.ts",
    "custom-elements.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "dist/border-wc.js",
    "dist/data-border-effect.js",
    "src/border-wc.js",
    "src/data-border-effect.js",
    "docs/**",
    "demos/**"
  ],
  "customElements": "custom-elements.json",
  "keywords": [
    "web-component",
    "custom-element",
    "border",
    "svg",
    "canvas",
    "vanilla-breeze"
  ],
  "author": "ProfPowell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProfPowell/border-wc.git"
  },
  "homepage": "https://profpowell.github.io/border-wc/",
  "bugs": {
    "url": "https://github.com/ProfPowell/border-wc/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "analyze": "cem analyze",
    "prepublishOnly": "npm run lint && npm run format:check && npm test && npm run build && npm run analyze",
    "site:dev": "vite --config vite.site.config.js",
    "site:build": "vite build --config vite.site.config.js",
    "site:preview": "vite preview --config vite.site.config.js"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@profpowell/browser-window": "^1.4.7",
    "@profpowell/code-block": "^2.9.0",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "vanilla-breeze": "^0.5.0",
    "vite": "^7.3.3"
  }
}
